{
    "name": "internick2017/shopgraph",
    "description": "Make WooCommerce products discoverable and purchasable by AI shopping agents.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^2",
        "wp-phpunit/wp-phpunit": "^6"
    },
    "autoload": {
        "psr-4": {
            "ShopGraph\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
